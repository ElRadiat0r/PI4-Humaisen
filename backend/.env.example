DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# La configuration P1 actuelle attend PostgreSQL.
DB_NAME=humaisen
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Le mode démo est local et synthétique. Pour un endpoint OpenAI-compatible :
# AI_PROVIDER=openai
# AI_API_URL=https://example.invalid/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=
AI_PROVIDER=demo
